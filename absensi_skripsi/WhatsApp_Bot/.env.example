# ============================================
# WhatsApp Bot — Konfigurasi Environment
# ============================================
# Salin file ini menjadi .env dan isi nilainya.
# Jangan commit file .env ke Git!

# Secret key untuk autentikasi API (wajib diisi, bebas string acak)
BOT_SECRET=ganti_dengan_secret_acak_kamu_disini

# Port server bot (default 3001)
PORT=3001

# Buat sesi bot otomatis ketika belum ada sesi tersimpan.
# Untuk demo skripsi, biarkan true agar QR bot1 langsung muncul di dashboard.
AUTO_START_SESSION=true
DEFAULT_SESSION_ID=bot1

# Nomor admin untuk notifikasi darurat (format: 62xxx tanpa +)
ADMIN_PHONE=6281234567890
