# ============================================
# WhatsApp Bot — Konfigurasi Environment
# ============================================
# Salin file ini menjadi .env dan isi nilainya.
# Jangan commit file .env ke Git!

# Secret key untuk autentikasi API (wajib diisi, bebas string acak)
BOT_SECRET=ganti_dengan_secret_acak_kamu_disini

# Port server bot (default 3001)
PORT=3001

# Nomor admin untuk notifikasi darurat (format: 62xxx tanpa +)
ADMIN_PHONE=6281234567890
