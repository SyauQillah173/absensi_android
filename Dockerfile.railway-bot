FROM ghcr.io/puppeteer/puppeteer:24.38.0

ENV NODE_ENV=production
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_CACHE_DIR=/root/.cache/puppeteer
ENV WA_AUTH_TIMEOUT_MS=600000
ENV XDG_CONFIG_HOME=/tmp/.chromium
ENV XDG_CACHE_HOME=/tmp/.chromium

USER root
WORKDIR /app
RUN mkdir -p /data

COPY . /tmp/source

RUN if [ -f /tmp/source/package.json ] && [ -f /tmp/source/server.js ]; then \
        cp -a /tmp/source/. /app/; \
    elif [ -d /tmp/source/absensi_skripsi/WhatsApp_Bot ]; then \
        cp -a /tmp/source/absensi_skripsi/WhatsApp_Bot/. /app/; \
    else \
        echo "Folder bot WhatsApp tidak ditemukan di build context."; \
        exit 1; \
    fi \
    && npm ci --omit=dev \
    && npx puppeteer browsers install chrome \
    && rm -rf /tmp/source

EXPOSE 3001

CMD ["npm", "start"]
