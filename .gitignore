#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Personal project notes / private local guides
/PANDUAN_*.txt
/PROMPT_*.txt
/PROPMT_*.txt

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/.kotlin/

# Project real, tidak ikut repository khusus skripsi
/admin_web/

# Platform non-Android tidak dipakai untuk skripsi Android
/ios/
/linux/
/macos/
/web/
/windows/

# Local editor settings
/.vscode/

# Node/Vercel/build artifacts
node_modules/
dist/
.vite/
.vercel/
*.tsbuildinfo

# Local secrets and machine-specific env files
**/.env
**/.env.*
!**/.env.example
